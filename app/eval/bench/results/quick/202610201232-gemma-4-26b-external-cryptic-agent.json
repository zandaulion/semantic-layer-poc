      "sql": "WITH branch_atm_counts AS (\n    SELECT\n        br.RGN_CD1 AS region_code,\n        br.DSPLY_NM AS branch_name,\n        COUNT(*) AS atm_txn_count\n    FROM bank_dwh.F_ATM_TXN txn\n    JOIN bank_dwh.D_BR br ON txn.BR_K = br.BR_K\n    WHERE br.IS_CURR = TRUE\n      AND txn.BUS_DT_K BETWEEN 20250101 AND 20251231\n    GROUP BY br.RGN_CD1, br.DSPLY_NM\n),\nranked_branches AS (\n    SELECT\n        region_code,\n        branch_name,\n        atm_txn_count,\n        RANK() OVER (PARTITION BY region_code ORDER BY atm_txn_count DESC) as rnk\n    FROM branch_atm_counts\n)\nSELECT\n    region_code,\n    branch_name,\n    atm_txn_count\nFROM ranked_branches\nWHERE rnk = 1\nORDER BY region_code;",
