      "sql": "-- Delete duplicate customer records in bank_dwh.dim_customer\n-- Keep the most recent version per business_id (based on effective_from_date)\nWITH ranked_customers AS (\n    SELECT\n        customer_key,\n        business_id,\n        effective_from_date,\n        ROW_NUMBER() OVER (PARTITION BY business_id ORDER BY effective_from_date DESC) AS rn\n    FROM bank_dwh.dim_customer\n)\nDELETE FROM bank_dwh.dim_customer dc\nUSING ranked_customers rc\nWHERE dc.customer_key = rc.customer_key\n  AND rc.rn > 1;"
