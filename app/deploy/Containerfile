# The PWA and its API.
#
# Built from the repository root, not from `app/`: the server resolves its
# catalogue as `<projectDir>/banking-poc/catalog.json`, one level above itself,
# so the image has to preserve that relationship rather than flatten it.
#
# There are no runtime npm dependencies, so there is nothing to install and
# nothing to audit — the image is Node plus this repository's own files.
FROM docker.io/library/node:24-alpine

ENV NODE_ENV=production
WORKDIR /srv/app

# Layout mirrors the checkout, so `projectDir` resolves the same way it does
# during development.
COPY app/package.json ./
COPY app/server ./server
COPY app/web ./web
COPY banking-poc /srv/banking-poc

# No USER directive, and that is deliberate under rootless Podman.
#
# Container-root here is not root: the user namespace maps it to the
# unprivileged account that started the service. Dropping to a second,
# in-image user instead would map to a subordinate uid that does not own the
# existing SQLite database on the bind mount, and the app would start unable to
# read the devices already registered. The isolation comes from the namespace,
# not from a uid inside it.
VOLUME ["/data"]
ENV DATA_DIR=/data
EXPOSE 4387

CMD ["node", "server/index.js"]
