  {
    "document_id": "guidance.dwh-poc.sales.revenue",
    "document_type": "guidance",
    "domain_id": "sales",
    "connection_id": "dwh-poc",
    "sql_dialect": "oracle",
    "dialect_version": "19c",
    "status": "approved",
    "access_scope_ids": [
      "sales-poc"
    ],
    "metadata_version": "poc-001",
    "content_version": 1,
    "source_updated_at": "2026-09-23T08:00:00Z",
    "indexed_at": "2026-09-23T09:00:00Z",
    "title": "Invoiced revenue: definition, customer join and invoice dates",
    "search_text": "Invoiced revenue billed revenue sales by customer in EUR. Sum invoice AMOUNT_EUR excluding CANCELLED invoices. Join invoices to customers using CUSTOMER_KEY. Filter invoice date with inclusive start and exclusive end. Group by CUSTOMER_ID and CUSTOMER_NAME. Calendar-year reporting; current customer name.",
    "physical_identifiers": [],
    "business_term_ids": [
      "acc-invoiced-revenue",
      "acc-customer-name",
      "acc-invoice-date"
    ],
    "business_term_names": [
      "Invoiced revenue",
      "Customer name",
      "Invoice date"
    ],
    "aliases": [],
    "dependency_ids": [
      "table.dwh-poc.sales.pd-100",
      "table.dwh-poc.sales.pd-200"
    ],
    "required_for_domain": true,
    "source_references": [
      {
        "system": "Reviewed guidance",
        "record_id": "sales-revenue-v1"
      }
    ],
    "guidance": {
      "summary": "Illustrative approved revenue rule for the two supplied tables.",
      "table_ids": [
        "table.dwh-poc.sales.pd-100",
        "table.dwh-poc.sales.pd-200"
      ],
      "joins": [
        {
          "join_id": "invoice_customer",
          "left_table_id": "table.dwh-poc.sales.pd-100",
          "right_table_id": "table.dwh-poc.sales.pd-200",
          "left_alias": "i",
          "right_alias": "c",
          "join_type": "INNER",
          "cardinality": "many_to_one",
          "predicate_sql": "i.CUSTOMER_KEY = c.CUSTOMER_KEY",
          "key_pairs": [
            {
              "left_column_id": "pd-102",
              "right_column_id": "pd-201"
            }
          ],
          "assumptions": [
            "DIM_CUSTOMER.CUSTOMER_KEY is unique.",
            "Each invoice has a matching customer.",
            "Customer keys are stable; no historical customer versions are present."
          ]
        }
      ],
      "rules": [
        {
          "rule_id": "invoiced_revenue_eur",
          "description": "Sum AMOUNT_EUR; amounts are already in EUR.",
          "expression_sql": "SUM(i.AMOUNT_EUR)",
          "unit": "EUR"
        },
        {
          "rule_id": "exclude_cancelled",
          "description": "Exclude cancelled invoices; status is non-null in this example.",
          "predicate_sql": "i.INVOICE_STATUS <> 'CANCELLED'"
        },
        {
          "rule_id": "invoice_period",
          "description": "Use invoice date, inclusive start and exclusive end.",
          "predicate_sql": "i.INVOICE_DATE >= :date_from AND i.INVOICE_DATE < :date_to"
        },
        {
          "rule_id": "customer_grouping",
          "description": "Group by customer business identifier and current name. Never group by name alone."
        }
      ],
      "date_role": {
        "column_id": "pd-103",
        "calendar": "calendar_year",
        "interval": "inclusive_start_exclusive_end"
      },
      "code_mappings": [
        {
          "column_id": "pd-105",
          "code": "CANCELLED",
          "label": "Cancelled"
        }
      ]
    }
  },
  {
    "document_id": "example.dwh-poc.sales.revenue-by-customer",
    "document_type": "example",
    "domain_id": "sales",
    "connection_id": "dwh-poc",
    "sql_dialect": "oracle",
    "dialect_version": "19c",
    "status": "approved",
    "access_scope_ids": [
      "sales-poc"
    ],
    "metadata_version": "poc-001",
    "content_version": 1,
    "source_updated_at": "2026-09-23T08:00:00Z",
    "indexed_at": "2026-09-23T09:00:00Z",
    "title": "Invoiced revenue by customer for a specified period",
    "search_text": "Show invoiced revenue in EUR by customer between two invoice dates. Billed revenue sales per client. Exclude cancelled invoices; group by unique customer business identifier and current customer name.",
    "physical_identifiers": [],
    "business_term_ids": [
      "acc-invoiced-revenue",
      "acc-customer-name",
      "acc-invoice-date"
    ],
    "business_term_names": [
      "Invoiced revenue",
      "Customer name",
      "Invoice date"
    ],
    "aliases": [],
    "dependency_ids": [
      "table.dwh-poc.sales.pd-100",
      "table.dwh-poc.sales.pd-200",
      "guidance.dwh-poc.sales.revenue"
    ],
    "required_for_domain": false,
    "source_references": [
      {
        "system": "Reviewed SQL",
        "record_id": "sales-query-001"
      }
    ],
    "example": {
      "question": "Show invoiced revenue in EUR by customer for a specified invoice-date period.",
      "sql": "SELECT c.CUSTOMER_ID,\n       c.CUSTOMER_NAME,\n       SUM(i.AMOUNT_EUR) AS INVOICED_REVENUE_EUR\nFROM DWH.FACT_INVOICE i\nJOIN DWH.DIM_CUSTOMER c\n  ON i.CUSTOMER_KEY = c.CUSTOMER_KEY\nWHERE i.INVOICE_STATUS <> 'CANCELLED'\n  AND i.INVOICE_DATE >= :date_from\n  AND i.INVOICE_DATE < :date_to\nGROUP BY c.CUSTOMER_ID, c.CUSTOMER_NAME",
      "explanation": "Uses the documented many-to-one customer join and invoice date. Amounts are already in EUR. Customers are grouped by identifier and current name.",
      "parameters": [
        {
          "name": "date_from",
          "data_type": "DATE",
          "description": "Inclusive invoice date."
        },
        {
          "name": "date_to",
          "data_type": "DATE",
          "description": "Exclusive invoice date."
        }
      ],
      "table_ids": [
        "table.dwh-poc.sales.pd-100",
        "table.dwh-poc.sales.pd-200"
      ],
      "guidance_ids": [
        "guidance.dwh-poc.sales.revenue"
      ],
      "review": {
        "review_reference": "illustrative-review-001",
        "reviewed_at": "2026-09-23T08:00:00Z"
      }
    }
  }
]
