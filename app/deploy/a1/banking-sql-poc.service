[Unit]
Description=Banking DWH Studio PWA and API
After=network-online.target banking-poc-elasticsearch.service
Wants=network-online.target banking-poc-elasticsearch.service

[Service]
Type=simple
WorkingDirectory=%h/semantic-layer-poc/app
EnvironmentFile=%h/.config/banking-sql-poc/server.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/banking-sql-poc

[Install]
WantedBy=default.target
