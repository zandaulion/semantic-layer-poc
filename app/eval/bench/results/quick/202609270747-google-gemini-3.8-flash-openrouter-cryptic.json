        }
      },
      "sql": "WITH branch_txn_counts AS (SELECT br.RGN_CD1 AS region_code, br.DSPLY_NM AS branch_name, COUNT(*) AS atm_txn_count, DENSE_RANK() OVER (PARTITION BY br.RGN_CD1 ORDER BY COUNT(*) DESC) AS rnk FROM bank_dwh.F_ATM_TXN f JOIN bank_dwh.D_DT dt ON f.BUS_DT_K = dt.DT_K JOIN bank_dwh.D_BR br ON f.BR_K = br.BR_K WHERE dt.CAL_YR_NBR = 2025 GROUP BY br.RGN_CD1, br.DSPLY_NM) SELECT region_code, branch_name, atm_txn_count FROM branch_txn_counts WHERE rnk = 1 ORDER BY region_code;",
      "outcome": "correct"
    },
