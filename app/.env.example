HOST=127.0.0.1
PORT=4387
PUBLIC_BASE_URL=https://your-public-pwa.example.com
# Absolute path; this file is read verbatim, without shell expansion.
DATA_DIR=/absolute/path/to/banking-sql-poc
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=banking-poc-current
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-20b
# Set these in a private server environment file; never commit their values.
ADMIN_TOKEN=
GROQ_API_KEY=
# Optional: a JSON object merged over every model request (see configuration.md).
# MODEL_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Optional: device ids allowed to start benchmark runs from the Run a test tab.
