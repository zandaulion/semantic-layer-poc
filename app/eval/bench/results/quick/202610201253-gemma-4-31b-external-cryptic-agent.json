      "sql": "WITH BranchCounts AS (\n    SELECT \n        br.RGN_CD1 AS region_code, \n        br.DSPLY_NM AS branch_name, \n        COUNT(*) AS txn_count,\n        RANK() OVER (PARTITION BY br.RGN_CD1 ORDER BY COUNT(*) DESC) as rnk\n    FROM bank_dwh.F_ATM_TXN f\n    JOIN bank_dwh.D_BR br ON f.BR_K = br.BR_K\n    JOIN bank_dwh.D_DT dt ON f.BUS_DT_K = dt.DT_K\n    WHERE dt.CAL_YR_NBR = 2025\n      AND br.IS_CURR = TRUE\n    GROUP BY br.RGN_CD1, br.DSPLY_NM\n)\nSELECT \n    region_code, \n    branch_name, \n    txn_count\nFROM BranchCounts\nWHERE rnk = 1;",
